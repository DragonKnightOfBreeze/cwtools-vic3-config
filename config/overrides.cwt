# Stellaris approach. See the override-strategy note under documents/ai-notes/domain/ and
# `scripts/util/fetch_override_strategies.py`.
#
# See: docs/en/ref-config-format.md#config-override
# Version: 3.0.4-dev
# Date: 2026-10-02

overrides = {
